// ======================= COMMAND LINE =======================

int main(int argc, char *argv[])
{
    /*
        Command Line Usage:

        Compress:
        program.exe -c input.txt compressed.huf

        Decompress:
        program.exe -d compressed.huf output.txt

        Analyze:
        program.exe -a input.txt

        Verify:
        program.exe -v original.txt output.txt
    */


    if(argc > 1)
    {
        string command = argv[1];

        // ================= COMPRESS =================

        if(command == "-c")
        {
            if(argc != 4)
            {
                cout << "\nUsage:\n";
                cout << "program.exe -c input.txt compressed.huf\n";

                return 0;
            }

            compressFile(argv[2],
                         argv[3]);

            return 0;
        }


        // ================= DECOMPRESS =================

        else if(command == "-d")
        {
            if(argc != 4)
            {
                cout << "\nUsage:\n";
                cout << "program.exe -d compressed.huf output.txt\n";

                return 0;
            }

            decompressFile(argv[2],
                           argv[3]);

            return 0;
        }


        // ================= ANALYZE =================

        else if(command == "-a")
        {
            if(argc != 3)
            {
                cout << "\nUsage:\n";
                cout << "program.exe -a input.txt\n";

                return 0;
            }

            vector<unsigned long long> freq(256, 0);

            unsigned long long fileSize = 0;

            ifstream file(argv[2],
                          ios::binary);

            if(!file)
            {
                cout << "\nError: File does not exist!\n";
                return 0;
            }

            file.close();

            analyzeFrequency(argv[2],
                             freq,
                             fileSize);

            cout << "\nFile Size: "
                 << fileSize
                 << " bytes\n";

            displayFrequency(freq);

            return 0;
        }


        // ================= VERIFY =================

        else if(command == "-v")
        {
            if(argc != 4)
            {
                cout << "\nUsage:\n";
                cout << "program.exe -v original.txt decompressed.txt\n";

                return 0;
            }

            if(verifyFiles(argv[2],
                           argv[3]))
            {
                cout << "\nVerification Successful!\n";
            }
            else
            {
                cout << "\nVerification Failed!\n";
            }

            return 0;
        }


        else
        {
            cout << "\nInvalid Command!\n";

            cout << "\nAvailable Commands:\n";

            cout << "-c  Compress File\n";
            cout << "-d  Decompress File\n";
            cout << "-a  Analyze File\n";
            cout << "-v  Verify Files\n";

            return 0;
        }
    }


    // If no command-line arguments
    // are provided, open normal menu.

    menu();

    return 0;
}
