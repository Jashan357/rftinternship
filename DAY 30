// ======================= WRITE INTEGER =======================

void writeLongLong(ofstream &file,
                   unsigned long long value)
{
    file.write((char*)&value,
               sizeof(value));
}


// ======================= READ INTEGER =======================

bool readLongLong(ifstream &file,
                  unsigned long long &value)
{
    return file.read((char*)&value,
                     sizeof(value));
}


// ======================= COMPRESS FILE =======================

bool compressFile(string inputFile,
                  string outputFile)
{
    vector<unsigned long long> freq(256, 0);

    unsigned long long originalSize = 0;

    // Read and analyze input file
    analyzeFrequency(inputFile,
                     freq,
                     originalSize);

    ifstream test(inputFile, ios::binary);

    if(!test)
    {
        cout << "\nError: Input file does not exist or cannot be opened!\n";
        return false;
    }

    test.close();

    if(originalSize == 0)
    {
        cout << "\nError: Input file is empty!\n";
        return false;
    }

    // Build Huffman tree
    Node *root = buildTree(freq);

    if(root == NULL)
    {
        cout << "\nError: Could not build Huffman tree!\n";
        return false;
    }

    // Generate codes
    vector<string> codes(256);

    generateCodes(root,
                  "",
                  codes);

    // Open files
    ifstream input(inputFile,
                   ios::binary);

    ofstream output(outputFile,
                    ios::binary);

    if(!input || !output)
    {
        cout << "\nError: Cannot create compressed file!\n";

        deleteTree(root);

        return false;
    }

    // ================= HEADER =================

    // Write original file size
    writeLongLong(output,
                  originalSize);

    // Write frequency table
    for(int i = 0; i < 256; i++)
    {
        writeLongLong(output,
                      freq[i]);
    }


    // ================= DATA =================

    unsigned char buffer = 0;
    int bitCount = 0;

    unsigned char ch;

    while(input.read((char*)&ch,
                     sizeof(ch)))
    {
        string code = codes[ch];

        for(char bit : code)
        {
            buffer <<= 1;

            if(bit == '1')
                buffer |= 1;

            bitCount++;

            if(bitCount == 8)
            {
                output.write((char*)&buffer,
                             sizeof(buffer));

                buffer = 0;
                bitCount = 0;
            }
        }
    }

    // Remaining bits
    if(bitCount > 0)
    {
        buffer <<= (8 - bitCount);

        output.write((char*)&buffer,
                     sizeof(buffer));
    }

    input.close();
    output.close();

    deleteTree(root);

    cout << "\n========================================\n";
    cout << "         COMPRESSION SUCCESSFUL\n";
    cout << "========================================\n";

    cout << "Input File       : "
         << inputFile << endl;

    cout << "Compressed File  : "
         << outputFile << endl;

    cout << "Original Size    : "
         << originalSize << " bytes\n";

    ifstream compressed(outputFile,
                        ios::binary | ios::ate);

    unsigned long long compressedSize =
        compressed.tellg();

    compressed.close();

    cout << "Compressed Size  : "
         << compressedSize << " bytes\n";

    if(originalSize > 0)
    {
        double ratio =
            ((double)compressedSize /
             originalSize) * 100;

        cout << "Compressed Ratio : "
             << fixed << setprecision(2)
             << ratio << "%\n";

        double saving =
            100 - ratio;

        cout << "Space Saved      : "
             << fixed << setprecision(2)
             << saving << "%\n";
    }

    cout << "========================================\n";

    return true;
}


// ======================= DECOMPRESS FILE =======================

bool decompressFile(string inputFile,
                    string outputFile)
{
    ifstream input(inputFile,
                   ios::binary);

    if(!input)
    {
        cout << "\nError: Compressed file not found!\n";
        return false;
    }

    // Read original size
    unsigned long long originalSize;

    if(!readLongLong(input,
                     originalSize))
    {
        cout << "\nError: Invalid compressed file!\n";
        return false;
    }

    // Read frequency table
    vector<unsigned long long> freq(256);

    for(int i = 0; i < 256; i++)
    {
        if(!readLongLong(input,
                         freq[i]))
        {
            cout << "\nError: Corrupted compressed file!\n";
            return false;
        }
    }

    // Build tree
    Node *root = buildTree(freq);

    if(root == NULL)
    {
        cout << "\nError: Invalid Huffman tree!\n";
        return false;
    }

    ofstream output(outputFile,
                    ios::binary);

    if(!output)
    {
        cout << "\nError: Cannot create output file!\n";

        deleteTree(root);

        return false;
    }


    // ================= SINGLE CHARACTER =================

    if(isLeaf(root))
    {
        unsigned char ch = root->ch;

        for(unsigned long long i = 0;
            i < originalSize;
            i++)
        {
            output.write((char*)&ch,
                         sizeof(ch));
        }

        input.close();
        output.close();

        deleteTree(root);

        cout << "\n========================================\n";
        cout << "        DECOMPRESSION SUCCESSFUL\n";
        cout << "========================================\n";

        cout << "Output File : "
             << outputFile << endl;

        cout << "Original Size Restored : "
             << originalSize << " bytes\n";

        cout << "========================================\n";

        return true;
    }


    // ================= NORMAL DECOMPRESSION =================

    Node *current = root;

    unsigned long long written = 0;

    unsigned char buffer;

    while(input.read((char*)&buffer,
                     sizeof(buffer)) &&
          written < originalSize)
    {
        for(int i = 7;
            i >= 0 && written < originalSize;
            i--)
        {
            int bit =
                (buffer >> i) & 1;

            if(bit == 0)
                current = current->left;
            else
                current = current->right;

            if(current == NULL)
            {
                cout << "\nError: Corrupted compressed file!\n";

                input.close();
                output.close();

                deleteTree(root);

                return false;
            }

            if(isLeaf(current))
            {
                output.write((char*)&current->ch,
                             sizeof(current->ch));

                written++;

                current = root;
            }
        }
    }

    input.close();
    output.close();

    deleteTree(root);

    if(written != originalSize)
    {
        cout << "\nError: Decompression failed!\n";
        cout << "Expected : "
             << originalSize << " bytes\n";

        cout << "Got      : "
             << written << " bytes\n";

        return false;
    }

    cout << "\n========================================\n";
    cout << "        DECOMPRESSION SUCCESSFUL\n";
    cout << "========================================\n";

    cout << "Compressed File : "
         << inputFile << endl;

    cout << "Output File     : "
         << outputFile << endl;

    cout << "Restored Size   : "
         << written << " bytes\n";

    cout << "========================================\n";

    return true;
}


// ======================= VERIFY FILES =======================

bool verifyFiles(string originalFile,
                 string decompressedFile)
{
    ifstream file1(originalFile,
                   ios::binary);

    ifstream file2(decompressedFile,
                   ios::binary);

    if(!file1 || !file2)
    {
        cout << "\nError: Cannot open files for verification!\n";
        return false;
    }

    unsigned char ch1;
    unsigned char ch2;

    while(true)
    {
        bool read1 =
            file1.read((char*)&ch1,
                       sizeof(ch1));

        bool read2 =
            file2.read((char*)&ch2,
                       sizeof(ch2));

        if(read1 != read2)
        {
            file1.close();
            file2.close();

            return false;
        }

        if(!read1)
            break;

        if(ch1 != ch2)
        {
            file1.close();
            file2.close();

            return false;
        }
    }

    file1.close();
    file2.close();

    return true;
}


// ======================= COMPARE FILE SIZE =======================

void compareFileSize(string originalFile,
                     string compressedFile)
{
    ifstream original(originalFile,
                      ios::binary | ios::ate);

    ifstream compressed(compressedFile,
                        ios::binary | ios::ate);

    if(!original || !compressed)
    {
        cout << "\nCannot compare file sizes!\n";
        return;
    }

    unsigned long long originalSize =
        original.tellg();

    unsigned long long compressedSize =
        compressed.tellg();

    original.close();
    compressed.close();

    cout << "\n========================================\n";
    cout << "             FILE SIZE REPORT\n";
    cout << "========================================\n";

    cout << "Original File Size   : "
         << originalSize
         << " bytes\n";

    cout << "Compressed File Size : "
         << compressedSize
         << " bytes\n";

    if(originalSize > 0)
    {
        double ratio =
            ((double)compressedSize /
             originalSize) * 100;

        double saving =
            100 - ratio;

        cout << "Compression Ratio    : "
             << fixed << setprecision(2)
             << ratio << "%\n";

        cout << "Space Saved          : "
             << fixed << setprecision(2)
             << saving << "%\n";
    }

    cout << "========================================\n";
}


