#include <bits/stdc++.h>
using namespace std;

// ======================= HUFFMAN NODE =======================

struct Node
{
    unsigned char ch;
    long long freq;

    Node *left;
    Node *right;

    Node(unsigned char c, long long f)
    {
        ch = c;
        freq = f;

        left = NULL;
        right = NULL;
    }

    Node(long long f, Node *l, Node *r)
    {
        ch = 0;
        freq = f;

        left = l;
        right = r;
    }
};


// ======================= COMPARATOR =======================

struct Compare
{
    bool operator()(Node *a, Node *b)
    {
        return a->freq > b->freq;
    }
};


// ======================= CHECK LEAF =======================

bool isLeaf(Node *root)
{
    return root != NULL &&
           root->left == NULL &&
           root->right == NULL;
}


// ======================= DELETE TREE =======================

void deleteTree(Node *root)
{
    if(root == NULL)
        return;

    deleteTree(root->left);
    deleteTree(root->right);

    delete root;
}


// ======================= CHARACTER FREQUENCY =======================

void analyzeFrequency(string fileName,
                      vector<unsigned long long> &freq,
                      unsigned long long &fileSize)
{
    ifstream file(fileName, ios::binary);

    if(!file)
    {
        cout << "\nError: Cannot open input file!\n";
        return;
    }

    unsigned char ch;

    fileSize = 0;

    while(file.read((char*)&ch, sizeof(ch)))
    {
        freq[ch]++;
        fileSize++;
    }

    file.close();
}


// ======================= DISPLAY FREQUENCY =======================

void displayFrequency(vector<unsigned long long> &freq)
{
    cout << "\n========================================\n";
    cout << "       CHARACTER FREQUENCY TABLE\n";
    cout << "========================================\n";

    bool found = false;

    for(int i = 0; i < 256; i++)
    {
        if(freq[i] > 0)
        {
            found = true;

            if(i >= 32 && i <= 126)
            {
                cout << "'" << (char)i << "'"
                     << " -> "
                     << freq[i] << endl;
            }
            else
            {
                cout << "ASCII " << i
                     << " -> "
                     << freq[i] << endl;
            }
        }
    }

    if(!found)
        cout << "File is Empty.\n";

    cout << "========================================\n";
}


// ======================= BUILD HUFFMAN TREE =======================

Node* buildTree(vector<unsigned long long> &freq)
{
    priority_queue<Node*,
                   vector<Node*>,
                   Compare> pq;

    for(int i = 0; i < 256; i++)
    {
        if(freq[i] > 0)
        {
            Node *newNode =
                new Node((unsigned char)i, freq[i]);

            pq.push(newNode);
        }
    }

    if(pq.empty())
        return NULL;

    // Special case:
    // Only one unique character
    if(pq.size() == 1)
    {
        Node *onlyNode = pq.top();
        pq.pop();

        Node *root =
            new Node(onlyNode->freq,
                     onlyNode,
                     NULL);

        return root;
    }

    while(pq.size() > 1)
    {
        Node *left = pq.top();
        pq.pop();

        Node *right = pq.top();
        pq.pop();

        Node *parent =
            new Node(left->freq + right->freq,
                     left,
                     right);

        pq.push(parent);
    }

    return pq.top();
}


// ======================= GENERATE HUFFMAN CODES =======================

void generateCodes(Node *root,
                   string code,
                   vector<string> &codes)
{
    if(root == NULL)
        return;

    if(isLeaf(root))
    {
        // If only one unique character exists
        if(code == "")
            code = "0";

        codes[root->ch] = code;

        return;
    }

    generateCodes(root->left,
                  code + "0",
                  codes);

    generateCodes(root->right,
                  code + "1",
                  codes);
}


