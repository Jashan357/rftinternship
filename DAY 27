// ======================= FIND MOVIE =======================

Movie* findMovie(int id)
{
    for(auto &m : movies)
    {
        if(m.movieId == id)
            return &m;
    }

    return NULL;
}


// ======================= FIND SHOW =======================

Show* findShow(int id)
{
    for(auto &s : shows)
    {
        if(s.showId == id)
            return &s;
    }

    return NULL;
}


// ======================= ADD MOVIE =======================

void addMovie()
{
    Movie m;

    m.movieId = nextMovieId++;

    cin.ignore();

    cout << "\nEnter Movie Name: ";
    getline(cin, m.name);

    cout << "Enter Genre: ";
    getline(cin, m.genre);

    cout << "Enter Duration (minutes): ";
    cin >> m.duration;

    movies.push_back(m);

    saveMovies();

    cout << "\nMovie Added Successfully!\n";
    cout << "Movie ID: " << m.movieId << endl;
}


// ======================= DISPLAY MOVIES =======================

void displayMovies()
{
    if(movies.empty())
    {
        cout << "\nNo Movies Available.\n";
        return;
    }

    cout << "\n========== MOVIES ==========\n";

    for(auto m : movies)
    {
        cout << "Movie ID  : " << m.movieId << endl;
        cout << "Name      : " << m.name << endl;
        cout << "Genre     : " << m.genre << endl;
        cout << "Duration  : " << m.duration << " minutes\n";
        cout << "----------------------------\n";
    }
}


// ======================= ADD SHOW =======================

void addShow()
{
    if(movies.empty())
    {
        cout << "\nPlease add a movie first.\n";
        return;
    }

    displayMovies();

    Show s;

    s.showId = nextShowId++;

    cout << "\nEnter Movie ID: ";
    cin >> s.movieId;

    if(findMovie(s.movieId) == NULL)
    {
        cout << "\nInvalid Movie ID!\n";
        return;
    }

    cin.ignore();

    cout << "Enter Show Timing: ";
    getline(cin, s.timing);

    cout << "Enter Total Seats: ";
    cin >> s.totalSeats;

    s.availableSeats = s.totalSeats;

    shows.push_back(s);

    saveShows();

    cout << "\nShow Added Successfully!\n";
    cout << "Show ID: " << s.showId << endl;
}


// ======================= DISPLAY SHOWS =======================

void displayShows()
{
    if(shows.empty())
    {
        cout << "\nNo Shows Available.\n";
        return;
    }

    cout << "\n========== SHOWS ==========\n";

    for(auto s : shows)
    {
        Movie *m = findMovie(s.movieId);

        cout << "Show ID       : " << s.showId << endl;

        if(m != NULL)
            cout << "Movie         : " << m->name << endl;

        cout << "Timing        : " << s.timing << endl;
        cout << "Total Seats   : " << s.totalSeats << endl;
        cout << "Available     : " << s.availableSeats << endl;

        cout << "---------------------------\n";
    }
}


// ======================= SEAT AVAILABILITY =======================

void seatAvailability()
{
    if(shows.empty())
    {
        cout << "\nNo Shows Available.\n";
        return;
    }

    displayShows();

    int showId;

    cout << "\nEnter Show ID: ";
    cin >> showId;

    Show *s = findShow(showId);

    if(s == NULL)
    {
        cout << "\nInvalid Show ID!\n";
        return;
    }

    cout << "\n========== SEAT AVAILABILITY ==========\n";

    for(int i = 1; i <= s->totalSeats; i++)
    {
        bool booked = false;

        for(auto b : bookings)
        {
            if(b.showId == showId &&
               b.seatNo == i &&
               b.status == "Booked")
            {
                booked = true;
                break;
            }
        }

        if(booked)
            cout << "[X] ";
        else
            cout << "[" << i << "] ";

        if(i % 10 == 0)
            cout << endl;
    }

    cout << "\n[X] = Booked\n";
}


// ======================= BOOK TICKET =======================

void bookTicket()
{
    if(shows.empty())
    {
        cout << "\nNo Shows Available.\n";
        return;
    }

    displayShows();

    int showId;

    cout << "\nEnter Show ID: ";
    cin >> showId;

    Show *s = findShow(showId);

    if(s == NULL)
    {
        cout << "\nInvalid Show ID!\n";
        return;
    }

    if(s->availableSeats <= 0)
    {
        cout << "\nHouse Full!\n";
        return;
    }

    int seatNo;

    seatAvailability();

    cout << "\nEnter Seat Number: ";
    cin >> seatNo;

    if(seatNo < 1 || seatNo > s->totalSeats)
    {
        cout << "\nInvalid Seat Number!\n";
        return;
    }

    for(auto b : bookings)
    {
        if(b.showId == showId &&
           b.seatNo == seatNo &&
           b.status == "Booked")
        {
            cout << "\nSeat Already Booked!\n";
            return;
        }
    }

    Booking b;

    b.ticketId = nextTicketId++;

    cin.ignore();

    cout << "Enter Customer Name: ";
    getline(cin, b.customerName);

    b.movieId = s->movieId;
    b.showId = showId;
    b.seatNo = seatNo;
    b.amount = ticketPrice;
    b.status = "Booked";

    bookings.push_back(b);

    s->availableSeats--;

    saveBookings();
    saveShows();

    cout << "\n=================================\n";
    cout << "       TICKET BOOKED!\n";
    cout << "=================================\n";
    cout << "Ticket ID    : " << b.ticketId << endl;
    cout << "Customer     : " << b.customerName << endl;

    Movie *m = findMovie(b.movieId);

    if(m != NULL)
        cout << "Movie        : " << m->name << endl;

    cout << "Show ID      : " << b.showId << endl;
    cout << "Seat Number  : " << b.seatNo << endl;
    cout << "Amount       : Rs. " << b.amount << endl;
    cout << "Status       : " << b.status << endl;
    cout << "=================================\n";
}


// ======================= CANCEL TICKET =======================

void cancelTicket()
{
    int ticketId;

    cout << "\nEnter Ticket ID: ";
    cin >> ticketId;

    for(auto &b : bookings)
    {
        if(b.ticketId == ticketId)
        {
            if(b.status == "Cancelled")
            {
                cout << "\nTicket Already Cancelled!\n";
                return;
            }

            b.status = "Cancelled";

            Show *s = findShow(b.showId);

            if(s != NULL)
                s->availableSeats++;

            saveBookings();
            saveShows();

            cout << "\nTicket Cancelled Successfully!\n";
            return;
        }
    }

    cout << "\nTicket Not Found!\n";
}


// ======================= GENERATE RECEIPT =======================

void generateReceipt()
{
    int ticketId;

    cout << "\nEnter Ticket ID: ";
    cin >> ticketId;

    for(auto b : bookings)
    {
        if(b.ticketId == ticketId)
        {
            Movie *m = findMovie(b.movieId);
            Show *s = findShow(b.showId);

            cout << "\n";
            cout << "========================================\n";
            cout << "          MOVIE TICKET RECEIPT\n";
            cout << "========================================\n";

            cout << "Ticket ID     : " << b.ticketId << endl;
            cout << "Customer Name : " << b.customerName << endl;

            if(m != NULL)
                cout << "Movie         : " << m->name << endl;

            if(s != NULL)
                cout << "Show Timing   : " << s->timing << endl;

            cout << "Seat Number   : " << b.seatNo << endl;
            cout << "Amount        : Rs. " << b.amount << endl;
            cout << "Status        : " << b.status << endl;

            cout << "========================================\n";

            return;
        }
    }

    cout << "\nTicket Not Found!\n";
}


// ======================= SEARCH BOOKING =======================

void searchBooking()
{
    int ticketId;

    cout << "\nEnter Ticket ID: ";
    cin >> ticketId;

    for(auto b : bookings)
    {
        if(b.ticketId == ticketId)
        {
            Movie *m = findMovie(b.movieId);
            Show *s = findShow(b.showId);

            cout << "\n========== BOOKING DETAILS ==========\n";

            cout << "Ticket ID     : " << b.ticketId << endl;
            cout << "Customer      : " << b.customerName << endl;

            if(m != NULL)
                cout << "Movie         : " << m->name << endl;

            if(s != NULL)
                cout << "Show Timing   : " << s->timing << endl;

            cout << "Seat Number   : " << b.seatNo << endl;
            cout << "Amount        : Rs. " << b.amount << endl;
            cout << "Status        : " << b.status << endl;

            cout << "======================================\n";

            return;
        }
    }

    cout << "\nBooking Not Found!\n";
}


// ======================= REVENUE REPORT =======================

void revenueReport()
{
    double revenue = 0;
    int totalBookings = 0;
    int cancelled = 0;

    for(auto b : bookings)
    {
        if(b.status == "Booked")
        {
            revenue += b.amount;
            totalBookings++;
        }
        else if(b.status == "Cancelled")
        {
            cancelled++;
        }
    }

    cout << "\n====================================\n";
    cout << "          REVENUE REPORT\n";
    cout << "====================================\n";

    cout << "Total Bookings   : " << totalBookings << endl;
    cout << "Cancelled Tickets: " << cancelled << endl;
    cout << "Total Revenue    : Rs. " << revenue << endl;

    cout << "====================================\n";
}


