#include <bits/stdc++.h>
using namespace std;

// ======================= MOVIE STRUCTURE =======================

struct Movie
{
    int movieId;
    string name;
    string genre;
    int duration;
};


// ======================= SHOW STRUCTURE =======================

struct Show
{
    int showId;
    int movieId;
    string timing;
    int totalSeats;
    int availableSeats;
};


// ======================= BOOKING STRUCTURE =======================

struct Booking
{
    int ticketId;
    string customerName;
    int movieId;
    int showId;
    int seatNo;
    double amount;
    string status;
};


// ======================= FILE NAMES =======================

string movieFile = "movies.txt";
string showFile = "shows.txt";
string bookingFile = "bookings.txt";


// ======================= GLOBAL DATA =======================

vector<Movie> movies;
vector<Show> shows;
vector<Booking> bookings;

int nextMovieId = 1;
int nextShowId = 1;
int nextTicketId = 1001;

double ticketPrice = 200;


// ======================= FILE HANDLING =======================

void saveMovies()
{
    ofstream file(movieFile);

    for(auto m : movies)
    {
        file << m.movieId << "|"
             << m.name << "|"
             << m.genre << "|"
             << m.duration << endl;
    }

    file.close();
}


void loadMovies()
{
    ifstream file(movieFile);

    if(!file)
        return;

    movies.clear();

    string line;

    while(getline(file, line))
    {
        stringstream ss(line);
        string temp;

        Movie m;

        getline(ss, temp, '|');
        m.movieId = stoi(temp);

        getline(ss, m.name, '|');

        getline(ss, m.genre, '|');

        getline(ss, temp, '|');
        m.duration = stoi(temp);

        movies.push_back(m);

        nextMovieId = max(nextMovieId, m.movieId + 1);
    }

    file.close();
}


void saveShows()
{
    ofstream file(showFile);

    for(auto s : shows)
    {
        file << s.showId << "|"
             << s.movieId << "|"
             << s.timing << "|"
             << s.totalSeats << "|"
             << s.availableSeats << endl;
    }

    file.close();
}


void loadShows()
{
    ifstream file(showFile);

    if(!file)
        return;

    shows.clear();

    string line;

    while(getline(file, line))
    {
        stringstream ss(line);
