
class student{
    public:
    void count_occ(string user_inp){
        ifstream file("ab.txt");
        if(!file){
            cout<<"file not found\n";
                return;
        }
        string ch;
        int c=0;
        vector<int> lines;
        int line_no=1;
while(getline(file,ch)){
    if(ch == user_inp){
        c++;
        lines.push_back(line_no);
    }
        line_no++;
}
    cout<<"number of occurence of "<<user_inp<<"is: "<<c<<" and the line number where they appears are: ";
    for(auto it:lines){
        cout<<it<<" ";
    }

        file.close();
    }
};
