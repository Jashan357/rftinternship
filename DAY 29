#include <bits/stdc++.h>
using namespace std;

// ======================= MENU ITEM STRUCTURE =======================

struct MenuItem
{
    int itemId;
    string name;
    string category;
    double price;
};


// ======================= ORDER STRUCTURE =======================

struct Order
{
    int orderId;
    string customerName;
    int tableNo;
    vector<int> itemIds;
    vector<int> quantities;
    double totalAmount;
    string status;
};


// ======================= RESERVATION STRUCTURE =======================

struct Reservation
{
    int reservationId;
    string customerName;
    string date;
    string time;
    int tableNo;
    int guests;
};


// ======================= FILE NAMES =======================

string menuFile = "menu.txt";
string orderFile = "orders.txt";
string reservationFile = "reservations.txt";


// ======================= GLOBAL DATA =======================

vector<MenuItem> menu;
vector<Order> orders;
vector<Reservation> reservations;

int nextItemId = 1;
int nextOrderId = 1001;
int nextReservationId = 501;


// ======================= FILE HANDLING =======================

void saveMenu()
{
    ofstream file(menuFile);

    for(auto m : menu)
    {
        file << m.itemId << "|"
             << m.name << "|"
             << m.category << "|"
             << m.price << endl;
    }

    file.close();
}


void loadMenu()
{
    ifstream file(menuFile);

    if(!file)
        return;

    menu.clear();

    string line;

    while(getline(file, line))
    {
        stringstream ss(line);
        string temp;

        MenuItem m;

        getline(ss, temp, '|');
        m.itemId = stoi(temp);

        getline(ss, m.name, '|');

        getline(ss, m.category, '|');

        getline(ss, temp, '|');
        m.price = stod(temp);

        menu.push_back(m);

        nextItemId = max(nextItemId, m.itemId + 1);
    }

    file.close();
}


void saveOrders()
{
    ofstream file(orderFile);

    for(auto o : orders)
    {
        file << o.orderId << "|"
             << o.customerName << "|"
             << o.tableNo << "|";

        // Store item IDs
        for(int i = 0; i < o.itemIds.size(); i++)
        {
            file << o.itemIds[i];

            if(i != o.itemIds.size() - 1)
                file << ",";
        }

        file << "|";

        // Store quantities
        for(int i = 0; i < o.quantities.size(); i++)
        {
            file << o.quantities[i];

            if(i != o.quantities.size() - 1)
                file << ",";
        }

        file << "|"
             << o.totalAmount << "|"
             << o.status << endl;
    }

    file.close();
}


void loadOrders()
{
    ifstream file(orderFile);

    if(!file)
        return;

    orders.clear();

    string line;

    while(getline(file, line))
    {
        stringstream ss(line);
        string temp;

        Order o;

        getline(ss, temp, '|');
        o.orderId = stoi(temp);

        getline(ss, o.customerName, '|');

        getline(ss, temp, '|');
        o.tableNo = stoi(temp);

        // Item IDs
        getline(ss, temp, '|');

        stringstream itemStream(temp);

        while(getline(itemStream, temp, ','))
        {
            if(!temp.empty())
                o.itemIds.push_back(stoi(temp));
        }

        // Quantities
        getline(ss, temp, '|');

        stringstream quantityStream(temp);

        while(getline(quantityStream, temp, ','))
        {
            if(!temp.empty())
                o.quantities.push_back(stoi(temp));
        }

        getline(ss, temp, '|');
        o.totalAmount = stod(temp);

        getline(ss, o.status, '|');

        orders.push_back(o);

        nextOrderId = max(nextOrderId, o.orderId + 1);
    }

    file.close();
}


void saveReservations()
{
    ofstream file(reservationFile);

    for(auto r : reservations)
    {
        file << r.reservationId << "|"
             << r.customerName << "|"
             << r.date << "|"
             << r.time << "|"
             << r.tableNo << "|"
             << r.guests << endl;
    }

    file.close();
}


void loadReservations()
{
    ifstream file(reservationFile);

    if(!file)
        return;

    reservations.clear();

    string line;

    while(getline(file, line))
    {
        stringstream ss(line);
        string temp;

        Reservation r;

        getline(ss, temp, '|');
        r.reservationId = stoi(temp);

        getline(ss, r.customerName, '|');

        getline(ss, r.date, '|');

        getline(ss, r.time, '|');

        getline(ss, temp, '|');
        r.tableNo = stoi(temp);

        getline(ss, temp, '|');
        r.guests = stoi(temp);

        reservations.push_back(r);

        nextReservationId =
            max(nextReservationId, r.reservationId + 1);
    }

    file.close();
}


// ======================= FIND MENU ITEM =======================

MenuItem* findItem(int id)
{
    for(auto &m : menu)
    {
        if(m.itemId == id)
            return &m;
    }

    return NULL;
}


// ======================= FIND ORDER =======================

Order* findOrder(int id)
{
    for(auto &o : orders)
    {
        if(o.orderId == id)
            return &o;
    }

    return NULL;
}


// ======================= ADD MENU ITEM =======================

void addMenuItem()
{
    MenuItem m;

    m.itemId = nextItemId++;

    cin.ignore();

    cout << "\nEnter Item Name: ";
    getline(cin, m.name);

    cout << "Enter Category: ";
    getline(cin, m.category);

    cout << "Enter Price: ";
    cin >> m.price;

    menu.push_back(m);

    saveMenu();

    cout << "\nMenu Item Added Successfully!\n";
    cout << "Item ID: " << m.itemId << endl;
}


// ======================= DISPLAY MENU =======================

void displayMenu()
{
    if(menu.empty())
    {
        cout << "\nNo Menu Items Available.\n";
        return;
    }

    cout << "\n========================================\n";
    cout << "              RESTAURANT MENU\n";
    cout << "========================================\n";

    for(auto m : menu)
    {
        cout << "Item ID  : " << m.itemId << endl;
        cout << "Name     : " << m.name << endl;
        cout << "Category : " << m.category << endl;
        cout << "Price    : Rs. " << m.price << endl;

        cout << "----------------------------------------\n";
    }
}


// ======================= PLACE ORDER =======================

void placeOrder()
{
    if(menu.empty())
    {
        cout << "\nMenu is Empty!\n";
        return;
    }

    Order o;

    o.orderId = nextOrderId++;
    o.status = "Pending";
    o.totalAmount = 0;

    cin.ignore();

    cout << "\nEnter Customer Name: ";
    getline(cin, o.customerName);

    cout << "Enter Table Number: ";
    cin >> o.tableNo;

    displayMenu();

    int n;

    cout << "\nHow many different items do you want to order? ";
    cin >> n;

    if(n <= 0)
    {
        cout << "\nInvalid Number of Items!\n";
        return;
    }

    for(int i = 0; i < n; i++)
    {
        int itemId;
        int quantity;

        cout << "\nEnter Item ID: ";
        cin >> itemId;

        MenuItem *item = findItem(itemId);

        if(item == NULL)
        {
            cout << "Invalid Item ID!\n";
            i--;
            continue;
        }

        cout << "Enter Quantity: ";
        cin >> quantity;

        if(quantity <= 0)
        {
            cout << "Invalid Quantity!\n";
            i--;
            continue;
        }

        o.itemIds.push_back(itemId);
        o.quantities.push_back(quantity);

        o.totalAmount += item->price * quantity;
    }

    orders.push_back(o);

    saveOrders();

    cout << "\n====================================\n";
    cout << "          ORDER PLACED!\n";
    cout << "====================================\n";

    cout << "Order ID : " << o.orderId << endl;
    cout << "Customer : " << o.customerName << endl;
    cout << "Table    : " << o.tableNo << endl;
    cout << "Amount   : Rs. " << o.totalAmount << endl;
    cout << "Status   : " << o.status << endl;

    cout << "====================================\n";
}


// ======================= UPDATE ORDER STATUS =======================

void updateOrderStatus()
{
    int orderId;

    cout << "\nEnter Order ID: ";
    cin >> orderId;

    Order *o = findOrder(orderId);

    if(o == NULL)
    {
        cout << "\nOrder Not Found!\n";
        return;
    }

    cout << "\nCurrent Status: " << o->status << endl;

    cout << "\n1. Pending\n";
    cout << "2. Preparing\n";
    cout << "3. Ready\n";
    cout << "4. Served\n";
    cout << "5. Cancelled\n";

    int choice;

    cout << "\nEnter New Status: ";
    cin >> choice;

    switch(choice)
    {
        case 1:
            o->status = "Pending";
            break;

        case 2:
            o->status = "Preparing";
            break;

        case 3:
            o->status = "Ready";
            break;

        case 4:
            o->status = "Served";
            break;

        case 5:
            o->status = "Cancelled";
            break;

        default:
            cout << "\nInvalid Choice!\n";
            return;
    }

    saveOrders();

    cout << "\nOrder Status Updated Successfully!\n";
}


// ======================= GENERATE BILL =======================

void generateBill()
{
    int orderId;

    cout << "\nEnter Order ID: ";
    cin >> orderId;

    Order *o = findOrder(orderId);

    if(o == NULL)
    {
        cout << "\nOrder Not Found!\n";
        return;
    }

    cout << "\n";
    cout << "==========================================\n";
    cout << "              RESTAURANT BILL\n";
    cout << "==========================================\n";

    cout << "Order ID : " << o->orderId << endl;
    cout << "Customer : " << o->customerName << endl;
    cout << "Table    : " << o->tableNo << endl;

    cout << "------------------------------------------\n";

    double subtotal = 0;

    for(int i = 0; i < o->itemIds.size(); i++)
    {
        MenuItem *item = findItem(o->itemIds[i]);

        if(item != NULL)
        {
            double itemTotal =
                item->price * o->quantities[i];

            cout << item->name
                 << " x "
                 << o->quantities[i]
                 << " = Rs. "
                 << itemTotal << endl;

            subtotal += itemTotal;
        }
    }

    double gst = subtotal * 0.05;
    double finalAmount = subtotal + gst;

    cout << "------------------------------------------\n";

    cout << "Subtotal : Rs. " << subtotal << endl;
    cout << "GST 5%   : Rs. " << gst << endl;
    cout << "Total    : Rs. " << finalAmount << endl;

    cout << "Status   : " << o->status << endl;

    cout << "==========================================\n";
}


// ======================= SEARCH ORDER =======================

void searchOrder()
{
    int orderId;

    cout << "\nEnter Order ID: ";
    cin >> orderId;

    Order *o = findOrder(orderId);

    if(o == NULL)
    {
        cout << "\nOrder Not Found!\n";
        return;
    }

    cout << "\n========== ORDER DETAILS ==========\n";

    cout << "Order ID : " << o->orderId << endl;
    cout << "Customer : " << o->customerName << endl;
    cout << "Table    : " << o->tableNo << endl;
    cout << "Status   : " << o->status << endl;

    cout << "\nOrdered Items:\n";

    for(int i = 0; i < o->itemIds.size(); i++)
    {
        MenuItem *item = findItem(o->itemIds[i]);

        if(item != NULL)
        {
            cout << item->name
                 << " x "
                 << o->quantities[i]
                 << endl;
        }
    }

    cout << "\nTotal Amount: Rs. "
         << o->totalAmount << endl;

    cout << "===================================\n";
}


