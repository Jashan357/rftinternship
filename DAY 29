// ======================= TABLE RESERVATION =======================

void reserveTable()
{
    Reservation r;

    r.reservationId = nextReservationId++;

    cin.ignore();

    cout << "\nEnter Customer Name: ";
    getline(cin, r.customerName);

    cout << "Enter Date (DD/MM/YYYY): ";
    getline(cin, r.date);

    cout << "Enter Time: ";
    getline(cin, r.time);

    cout << "Enter Table Number: ";
    cin >> r.tableNo;

    cout << "Enter Number of Guests: ";
    cin >> r.guests;

    // Check if table is already reserved
    for(auto existing : reservations)
    {
        if(existing.date == r.date &&
           existing.time == r.time &&
           existing.tableNo == r.tableNo)
        {
            cout << "\nTable Already Reserved!\n";
            return;
        }
    }

    reservations.push_back(r);

    saveReservations();

    cout << "\n====================================\n";
    cout << "       TABLE RESERVED SUCCESSFULLY\n";
    cout << "====================================\n";

    cout << "Reservation ID : "
         << r.reservationId << endl;

    cout << "Customer       : "
         << r.customerName << endl;

    cout << "Date           : "
         << r.date << endl;

    cout << "Time           : "
         << r.time << endl;

    cout << "Table          : "
         << r.tableNo << endl;

    cout << "Guests         : "
         << r.guests << endl;

    cout << "====================================\n";
}


