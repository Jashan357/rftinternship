// ======================= DAILY SALES REPORT =======================

void dailySalesReport()
{
    double totalSales = 0;
    int totalOrders = 0;

    for(auto o : orders)
    {
        if(o.status != "Cancelled")
        {
            totalSales += o.totalAmount;
            totalOrders++;
        }
    }

    cout << "\n====================================\n";
    cout << "          DAILY SALES REPORT\n";
    cout << "====================================\n";

    cout << "Total Orders : "
         << totalOrders << endl;

    cout << "Total Sales  : Rs. "
         << totalSales << endl;

    cout << "====================================\n";
}


