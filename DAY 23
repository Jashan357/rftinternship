#include <bits/stdc++.h>
using namespace std;

class Account {
public:
    int accNo;
    string name;
    int pin;
    double balance;
    vector<string> history;

    Account() {
        accNo = 0;
        name = "";
        pin = 0;
        balance = 0;
    }

    Account(int accNo, string name, int pin, double balance = 0) {
        this->accNo = accNo;
        this->name = name;
        this->pin = pin;
        this->balance = balance;
    }
};


class Bank {
private:
    vector<Account> accounts;

public:

    //find account using account number
    int findAccount(int accNo) {
        for (int i = 0; i < accounts.size(); i++) {
            if (accounts[i].accNo == accNo) {
                return i;
            }
        }
        return -1;
    }


    //create a new account
    void createAccount() {
        Account a;

        cout << "\nEnter Account Number: ";
        cin >> a.accNo;

        if (findAccount(a.accNo) != -1) {
            cout << "Account already exists!\n";
            return;
        }

        cout << "Enter Name: ";
        cin.ignore();
        getline(cin, a.name);

        cout << "Create 4 digit PIN: ";
        cin >> a.pin;

        a.balance = 0;

        a.history.push_back("Account Created");

        accounts.push_back(a);

        cout << "Account created successfully!\n";
    }


    //check pin before doing operation
    bool checkPin(int index) {
        int enteredPin;

        cout << "Enter PIN: ";
        cin >> enteredPin;

        if (accounts[index].pin != enteredPin) {
            cout << "Wrong PIN!\n";
            return false;
        }

        return true;
    }


    //deposit money
    void deposit() {
        int accNo;
        double amount;

        cout << "\nEnter Account Number: ";
        cin >> accNo;

        int index = findAccount(accNo);

        if (index == -1) {
            cout << "Account not found!\n";
            return;
        }

        if (!checkPin(index)) return;

        cout << "Enter Amount: ";
        cin >> amount;

        if (amount <= 0) {
            cout << "Invalid amount!\n";
            return;
        }

        accounts[index].balance += amount;

        accounts[index].history.push_back(
            "Deposit: +" + to_string(amount)
        );

        cout << "Money deposited successfully!\n";
    }


    //withdraw money
    void withdraw() {
        int accNo;
        double amount;

        cout << "\nEnter Account Number: ";
        cin >> accNo;

        int index = findAccount(accNo);

        if (index == -1) {
            cout << "Account not found!\n";
            return;
        }

        if (!checkPin(index)) return;

        cout << "Enter Amount: ";
        cin >> amount;

        if (amount <= 0) {
            cout << "Invalid amount!\n";
            return;
        }

        //checking if enough balance is present
        if (amount > accounts[index].balance) {
            cout << "Insufficient balance!\n";
            return;
        }

        accounts[index].balance -= amount;

        accounts[index].history.push_back(
            "Withdrawal: -" + to_string(amount)
        );

        cout << "Money withdrawn successfully!\n";
    }


    //show current balance
    void checkBalance() {
        int accNo;

        cout << "\nEnter Account Number: ";
        cin >> accNo;

        int index = findAccount(accNo);

        if (index == -1) {
            cout << "Account not found!\n";
            return;
        }

        if (!checkPin(index)) return;

        cout << "Current Balance: Rs. "
             << accounts[index].balance << "\n";
    }


    //show all transactions of user
    void transactionHistory() {
        int accNo;

        cout << "\nEnter Account Number: ";
        cin >> accNo;

        int index = findAccount(accNo);

        if (index == -1) {
            cout << "Account not found!\n";
            return;
        }

        if (!checkPin(index)) return;

        cout << "\n----- TRANSACTION HISTORY -----\n";

        for (string transaction : accounts[index].history) {
            cout << transaction << "\n";
        }
    }


    //admin can see all accounts
    void viewAllAccounts() {
        if (accounts.empty()) {
            cout << "No accounts found!\n";
            return;
        }

        cout << "\n----- ALL ACCOUNTS -----\n";

        for (Account a : accounts) {
            cout << "\nAccount No: " << a.accNo;
            cout << "\nName: " << a.name;
            cout << "\nBalance: Rs. " << a.balance << "\n";
        }
    }


    //admin menu
    void adminPanel() {
        int choice;

        do {
            cout << "\n===== ADMIN PANEL =====\n";
            cout << "1. View All Accounts\n";
            cout << "2. Search Account\n";
            cout << "3. View Total Bank Balance\n";
            cout << "4. Back\n";

            cout << "Enter choice: ";
            cin >> choice;

            if (choice == 1) {
                viewAllAccounts();
            }

            else if (choice == 2) {
                int accNo;

                cout << "Enter Account Number: ";
                cin >> accNo;

                int index = findAccount(accNo);

                if (index == -1) {
                    cout << "Account not found!\n";
                }
                else {
                    cout << "Name: " << accounts[index].name << "\n";
                    cout << "Balance: "
                         << accounts[index].balance << "\n";
                }
            }

            else if (choice == 3) {
                double total = 0;

                for (Account a : accounts) {
                    total += a.balance;
                }

                cout << "Total Bank Balance: Rs. "
                     << total << "\n";
            }

        } while (choice != 4);
    }


    //generate statement for user
    void monthlyStatement() {
        int accNo;

        cout << "\nEnter Account Number: ";
        cin >> accNo;

        int index = findAccount(accNo);

        if (index == -1) {
            cout << "Account not found!\n";
            return;
        }

        if (!checkPin(index)) return;

        cout << "\n=================================\n";
        cout << "        MONTHLY STATEMENT\n";
        cout << "=================================\n";

        cout << "Account Holder: "
             << accounts[index].name << "\n";

        cout << "Account Number: "
             << accounts[index].accNo << "\n\n";

        for (string transaction : accounts[index].history) {
            cout << transaction << "\n";
        }

        cout << "\nCurrent Balance: Rs. "
             << accounts[index].balance << "\n";

        cout << "=================================\n";
    }


    //main menu
    void menu() {
        int choice;

        do {
            cout << "\n=================================\n";
            cout << "     BANK MANAGEMENT SYSTEM\n";
            cout << "=================================\n";

            cout << "1. Create Account\n";
            cout << "2. Deposit Money\n";
            cout << "3. Withdraw Money\n";
            cout << "4. Check Balance\n";
            cout << "5. Transaction History\n";
            cout << "6. Monthly Statement\n";
            cout << "7. Admin Panel\n";
            cout << "8. Exit\n";

            cout << "Enter your choice: ";
            cin >> choice;

            switch (choice) {

                case 1:
                    createAccount();
                    break;

                case 2:
                    deposit();
                    break;

                case 3:
                    withdraw();
                    break;

                case 4:
                    checkBalance();
                    break;

                case 5:
                    transactionHistory();
                    break;

                case 6:
                    monthlyStatement();
                    break;

                case 7:
                    adminPanel();
                    break;

                case 8:
                    cout << "Thank you for using our Bank!\n";
                    break;

                default:
                    cout << "Invalid choice!\n";
            }

        } while (choice != 8);
    }
};


int main() {

    //creating bank object
    Bank bank;

    //starting the bank system
    bank.menu();

    return 0;
}
